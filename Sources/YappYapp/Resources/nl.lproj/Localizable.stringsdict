			<key>other</key>
			<string>%lld WOORDEN · KLAAR OM TE KOPIËREN OF BEWAREN</string>
		</dict>
	</dict>
	<key>Saves %lld snippets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
