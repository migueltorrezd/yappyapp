			<key>other</key>
			<string>Bewaart %lld woorden</string>
		</dict>
	</dict>
	<key>Words and %lld snippets in one file. Never your history</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
