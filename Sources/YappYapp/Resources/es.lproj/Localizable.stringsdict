<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld DAYS</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld DÍA</string>
			<key>other</key>
			<string>%lld DÍAS</string>
		</dict>
	</dict>
	<key>%lld snippets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld fragmento</string>
			<key>other</key>
			<string>%lld fragmentos</string>
		</dict>
	</dict>
	<key>%lld dictations</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dictado</string>
			<key>other</key>
			<string>%lld dictados</string>
		</dict>
	</dict>
	<key>%lld words</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld palabra</string>
			<key>other</key>
			<string>%lld palabras</string>
		</dict>
	</dict>
	<key>%lld WORDS · READY TO COPY OR SAVE</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld PALABRA · LISTA PARA COPIAR O GUARDAR</string>
			<key>other</key>
			<string>%lld PALABRAS · LISTAS PARA COPIAR O GUARDAR</string>
		</dict>
	</dict>
	<key>Saves %lld snippets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Guarda %lld fragmento</string>
			<key>other</key>
			<string>Guarda %lld fragmentos</string>
		</dict>
	</dict>
	<key>Saves %lld words</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Guarda %lld palabra</string>
			<key>other</key>
			<string>Guarda %lld palabras</string>
		</dict>
	</dict>
	<key>Words and %lld snippets in one file. Never your history</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Palabras y %lld fragmento en un solo archivo. Nunca tu historial</string>
			<key>other</key>
			<string>Palabras y %lld fragmentos en un solo archivo. Nunca tu historial</string>
		</dict>
	</dict>
</dict>
</plist>
